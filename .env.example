# Cosmic Eye application settings (used by the existing web app).
# This file contains examples only. Put credentials in a local .env file.

IRSA_BASE_URL=https://irsa.ipac.caltech.edu
FRONTEND_ORIGIN=http://localhost:5173
CACHE_TTL_SECONDS=300
MAX_RESULTS=50
MAX_DOWNLOAD_BYTES=50000000
REQUEST_TIMEOUT_SECONDS=30

# Big Data Analytics course pipeline (Phase 1)
# Suggested ID only; check availability when creating your own GCP project.
GCP_PROJECT_ID=cosmic-eye-telemetry-demo
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json
BIGQUERY_LOCATION=US
BIGQUERY_RAW_DATASET=raw
BIGQUERY_CURATED_DATASET=curated
BIGQUERY_SMOKE_DATASET=phase1_smoke

# Leave blank until you create an Atlas Free cluster. Never share this URI.
MONGODB_URI=
MONGODB_DATABASE=cosmic_eye
MONGODB_MAX_SUMMARY_DOCS=10000

# Local Redpanda Kafka-compatible endpoint.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXPOSURE_TOPIC=exposure-events
KAFKA_USAGE_TOPIC=app-usage-events
KAFKA_REJECTED_TOPIC=rejected-events
KAFKA_LIVE_TOPIC=cosmic-eye-live
